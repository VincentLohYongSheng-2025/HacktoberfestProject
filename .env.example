DEMO_MODE=true
STORAGE_DRIVER=local
AI_PROVIDER=litellm
AI_BASE_URL=https://litellm.rapidscreen.io/v1
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=
AI_TIMEOUT_MS=20000
AI_SESSION_LIMIT=30
OPERATOR_ACCESS_CODE=
# Local isolated demo only. Do not use a local disk store on serverless hosting.
# Supabase integration is prepared but not enabled for this local build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional immediate, isolated partner demo sessions (requires DEMO_MODE=true)
DEMO_AUTO_APPROVE=false
